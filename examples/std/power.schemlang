# std/power.schemlang
#
# Standard power-rail circuit family.
# Demonstrates: protocol-flavored circuits with refinement and
# cardinality (one source, many sinks per rail), and the first-class
# tolerance form folding `Vnom` + `Vtol` into a single declaration.
#
# A power rail's nominal voltage is *interval-valued*: it carries
# `Vnom`, `Vlo`, `Vhi`, where Vlo and Vhi are auto-derived from the
# tolerance clause. Pin-side `constraint net.V in [Vmin, Vmax]` reads
# as containment (docs/02-semantic-model.md section 6.1) and catches
# rails whose worst-case corner exceeds a chip's recommended window.

define <POWER>
  lane POSITIVE  : power
  lane NEGATIVE  : power

  # Vnom is the rail's nominal centre. The tolerance clause is
  # supplied by refinements (<3V3>, <5V0>, ...) or via `derive` from
  # a participating source. A bare <POWER> in a bus instance leaves
  # Vnom as a free interval-valued variable that the elaborator
  # narrows from connected sources.
  parameter Vnom : voltage

  role source
    cardinality = 1                   # one source per power-bus instance
    drives    { POSITIVE, NEGATIVE }
    # The source's Vnom (with its tolerance) is the rail's reference;
    # derived equality unifies the interval across the bus instance.
    derive Vnom = supply.Vnom

  role sink
    cardinality >= 1                  # many loads per rail
    receives  { POSITIVE, NEGATIVE }
    parameter I_load : current = 0 mA

  # The rail's POSITIVE-vs-NEGATIVE differential is the Vnom interval.
  # Field access (.Vlo / .Vhi) reaches the worst-case bounds; for a
  # point-valued rail (no tolerance) the three fields collapse.
  constraint POSITIVE.V == Vnom


define <GND> : <POWER>
  # A bare ground reference. POSITIVE is unused; only NEGATIVE matters.
  override parameter Vnom : voltage = 0 V
  constraint NEGATIVE.V == 0 V


define <3V3> : <POWER>
  # 3.3 V rail with 3% symmetric tolerance: Vlo = 3.201 V, Vhi = 3.399 V.
  override parameter Vnom : voltage = 3.3 V +/- 3 %


define <1V8> : <POWER>
  override parameter Vnom : voltage = 1.8 V +/- 3 %


define <2V5> : <POWER>
  override parameter Vnom : voltage = 2.5 V +/- 3 %


define <5V0> : <POWER>
  override parameter Vnom : voltage = 5.0 V +/- 5 %


# Examples of asymmetric and one-sided tolerance forms (from real
# regulator datasheets). Any of these forms is accepted everywhere a
# tolerance can appear.
#
# define <vbus_usb>  : <POWER>
#   override parameter Vnom : voltage = 5.0 V + 0.25 V, - 0.6 V
#
# define <ldo_3v3_low_overshoot> : <POWER>
#   override parameter Vnom : voltage = 3.3 V + 1 %, - 3 %
#
# define <ref_2v5_one_sided> : <POWER>
#   override parameter Vnom : voltage = 2.5 V + 5 mV          # one-sided up
